---
import WaitlistArq from './WaitlistArq';
import Isologo from '../marca/Isologo.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const actores = ['Proveedores', 'Distribuidores', 'Minoristas', 'Profesionales', 'Gremios', 'Inmobiliarias', 'Artistas', 'Clientes'];
const materiales = ['Mármol', 'Roble', 'Hormigón', 'Bronce', 'Cuarzo', 'Nogal', 'Acero', 'Travertino', 'Lino'];

const laminas = [
  { code: 'A-01', name: 'Inspiración', title: ['Buscás ', 'inspiración.'], text: 'Explorás proyectos reales de profesionales de la construcción. Filtrás por estilo, escala y zona.' },
  { code: 'A-02', name: 'Encuentro', title: ['Algo te ', 'representa.'], text: 'Encontrás la obra que imaginabas. El profesional que la hizo está a un mensaje.' },
  { code: 'A-03', name: 'Consulta', title: ['La consulta ', 'llega.'], text: 'El profesional recibe el contacto directo. Sin intermediarios, sin agencias en el medio.' },
  { code: 'A-04', name: 'Materiales', title: ['El profesional ', 'elige.'], text: 'Accede a proveedores y materiales desde la misma plataforma. Todo en un lugar.', materiales: true },
  { code: 'A-05', name: 'Conexión', title: ['Todo ', 'coordinado.'], text: 'Clientes, profesionales, proveedores y gremios en el momento exacto en que se necesitan.' },
  { code: 'A-06', name: 'Obra', title: ['Así se hace ', 'una obra.'], text: 'De la idea a la realidad. Sin intermediarios, sin vueltas.' },
];
---

<section id="arq" class="arq" aria-labelledby="arq-title">
  <div class="wrap arq__intro">
    <div class="arq__copy">
      <p class="arq__lock">
        <Isologo part="arq" class="arq__lock-mark" />
        <span>Integhra <b>ARQ</b></span>
      </p>
      <h2 id="arq-title" class="arq__title">El ecosistema digital de la construcción y el diseño.</h2>
      <p class="arq__body">
        Conecta proveedores, distribuidores, minoristas, profesionales, gremios, inmobiliarias, artistas y consumidores finales en una única plataforma. Desde la inspiración y el diseño hasta la ejecución de la obra.
      </p>
      <dl class="arq__spec">
        <div><dt>Estado</dt><dd>En desarrollo</dd></div>
        <div><dt>Mercado inicial</dt><dd>Argentina</dd></div>
        <div><dt>Apertura</dt><dd>Septiembre 2026</dd></div>
      </dl>
    </div>

    <figure class="plan" aria-labelledby="plan-cap">
      <svg viewBox="0 0 600 460" role="img" aria-labelledby="plan-cap">
        <g class="plan__walls">
          <path pathLength="1" d="M40 40 H560 V380 H40 Z" />
          <path pathLength="1" d="M300 40 V200 M300 260 V380" />
          <path pathLength="1" d="M40 220 H180 M230 220 H300" />
          <path pathLength="1" d="M300 200 H420 M470 200 H560" />
          <path pathLength="1" d="M420 200 V380" />
        </g>
        <g class="plan__doors">
          <path pathLength="1" d="M180 220 A50 50 0 0 1 230 170" />
          <path pathLength="1" d="M300 200 A60 60 0 0 0 360 260" />
          <path pathLength="1" d="M420 200 A50 50 0 0 1 470 250" />
        </g>
        <g class="plan__dims">
          <path pathLength="1" d="M40 410 H560 M40 402 V418 M560 402 V418" />
          <path pathLength="1" d="M584 40 V380 M576 40 H592 M576 380 H592" />
        </g>
        <g class="plan__labels">
          <text x="170" y="130">LIVING</text>
          <text x="105" y="305">DORM. 1</text>
          <text x="360" y="125">COCINA</text>
          <text x="345" y="300">DORM. 2</text>
          <text x="470" y="300">BAÑO</text>
          <text class="plan__dim" x="300" y="440" text-anchor="middle">8.40</text>
          <text class="plan__dim" x="572" y="214" text-anchor="end">6.20</text>
        </g>
      </svg>
      <figcaption id="plan-cap" class="plan__block">
        <span>RES 001/25</span>
        <span>Planta · Esc 1:50</span>
        <span>Integhra 2026</span>
      </figcaption>
    </figure>
  </div>

  <div class="wrap arq__actors">
    <h3>Conecta a</h3>
    <ul>{actores.map((a) => <li>{a}</li>)}</ul>
  </div>

  <div class="wrap lam" id="recorrido">
    <h3 class="lam__title">Así va a funcionar Integhra ARQ</h3>
    <ol class="lam__grid">
      {laminas.map((l, i) => (
        <li class="lam__sheet" data-reveal style={`--i: ${i}`}>
          <p class="lam__code">
            <span>{l.code}</span>
            <span>{l.name}</span>
          </p>
          <h4>{l.title[0]}<em>{l.title[1]}</em></h4>
          <p class="lam__text">{l.text}</p>
          {l.materiales && (
            <ul class="lam__mat" aria-label="Materiales">
              {materiales.map((m) => <li>{m}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </div>

  <WaitlistArq client:visible />
</section>

<style>
  .arq {
    --b: #3aa3f5;
    --v: #c04fd3;
    --line: #2a303b;
    --mut: #a9b1be;
    background: #121419;
    color: #eef1f6;
    padding-top: clamp(5rem, 12vh, 8rem);
    font-family: var(--font);
  }
  .arq ::selection {
    background: var(--b);
    color: #121419;
  }
  .arq :focus-visible {
    outline-color: #eef1f6;
  }

  .arq__intro {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .arq__copy {
    display: grid;
    gap: 1.25rem;
  }
  .arq__lock {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-variation-settings: 'wdth' 110;
    font-size: 1.125rem;
  }
  .arq__lock :global(.arq__lock-mark) {
    width: auto;
    height: 40px;
  }
  .arq__lock b {
    color: var(--v);
  }
  .arq__title {
    font-size: clamp(2.4rem, 4.6vw, 4.25rem);
    font-weight: 800;
    font-variation-settings: 'wdth' 120;
    letter-spacing: -0.035em;
    line-height: 0.98;
    text-wrap: balance;
  }
  .arq__body {
    color: #c3c9d4;
    max-width: 50ch;
    font-size: 1.0625rem;
  }
  .arq__spec {
    border-top: 1px solid var(--line);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.875rem;
  }
  .arq__spec div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }
  .arq__spec dt {
    color: var(--mut);
    text-transform: uppercase;
  }
  .arq__spec dd {
    color: var(--b);
    text-transform: uppercase;
  }

  /* The plan draws itself as it crosses the viewport */
  .plan {
    margin: 0;
    border: 1px solid var(--line);
    padding: clamp(1rem, 2vw, 1.75rem);
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 40px 40px;
    background-color: #14171d;
  }
  .plan svg {
    width: 100%;
    height: auto;
  }
  .plan path {
    fill: none;
    stroke-linecap: square;
  }
  .plan__walls path {
    stroke: #eef1f6;
    stroke-width: 5;
  }
  .plan__doors path {
    stroke: var(--v);
    stroke-width: 2;
  }
  .plan__dims path {
    stroke: var(--b);
    stroke-width: 1.5;
  }
  .plan__labels text {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    fill: var(--mut);
    letter-spacing: 0.05em;
  }
  .plan__labels .plan__dim {
    fill: var(--b);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .plan path {
        stroke-dasharray: 1;
        animation: plan-draw linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 55%;
      }
      .plan__labels {
        animation: plan-ink linear both;
        animation-timeline: view();
        animation-range: cover 35% cover 55%;
      }
    }
  }
  @keyframes plan-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes plan-ink {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .plan__block {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0;
    margin-top: 1rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--mut);
  }
  .plan__block span {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line);
    margin-left: -1px;
  }

  .arq__actors {
    margin-top: clamp(4rem, 9vh, 6rem);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 2rem;
  }
  .arq__actors h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--mut);
  }
  .arq__actors ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
  }
  .arq__actors li {
    font-size: clamp(1.25rem, 2.2vw, 2rem);
    font-weight: 700;
    font-variation-settings: 'wdth' 70;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .arq__actors li:nth-child(odd) {
    color: var(--b);
  }

  /* Sheets: the six-step journey as drawing sheets */
  .lam {
    margin-top: clamp(5rem, 12vh, 8rem);
  }
  .lam__title {
    font-size: clamp(2.2rem, 4.4vw, 4rem);
    font-weight: 800;
    font-variation-settings: 'wdth' 118;
    letter-spacing: -0.03em;
    line-height: 1;
    max-width: 14ch;
    margin-bottom: clamp(2rem, 5vh, 3rem);
  }
  .lam__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .lam__sheet {
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: clamp(1.25rem, 2.4vw, 2rem);
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-height: 260px;
    transition: background-color 0.3s ease;
  }
  .lam__sheet:hover {
    background: #171a21;
  }
  .lam__code {
    display: flex;
    justify-content: space-between;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.8125rem;
    text-transform: uppercase;
    color: var(--mut);
  }
  .lam__code span:first-child {
    color: var(--v);
  }
  .lam__sheet h4 {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: 750;
    font-variation-settings: 'wdth' 112;
    letter-spacing: -0.025em;
    line-height: 1.05;
    padding-bottom: 0.1em;
  }
  .lam__sheet em {
    color: var(--b);
  }
  .lam__text {
    color: #c3c9d4;
    max-width: 34ch;
  }
  .lam__mat {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }
  .lam__mat li {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--line);
    color: #d7dce4;
  }

  @media (max-width: 600px) {
    .plan__labels text {
      font-size: 22px;
    }
  }
  @media (max-width: 960px) {
    .arq__intro {
      grid-template-columns: 1fr;
    }
    .lam__grid {
      grid-template-columns: 1fr;
    }
    .lam__sheet {
      min-height: 0;
    }
  }
  @media (min-width: 961px) and (max-width: 1180px) {
    .lam__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
