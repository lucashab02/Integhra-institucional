---
import WaitlistArq from './WaitlistArq';
import Isologo from '../marca/Isologo.astro';
import Planta from './Planta.astro';
import Proceso from './Proceso.astro';

interface Props {
  /** h1 when the section is the page itself (/arq) */
  heading?: 'h1' | 'h2';
}
const { heading: Heading = 'h2' } = Astro.props;

const actores = ['Proveedores', 'Profesionales', 'Consumidores'];
---

<section id="arq" class="arq" aria-labelledby="arq-title">
  <!-- Hero, product-page style: the name small, one big line, one short line,
       and the plan as the object, lying on the table and running off the bottom edge -->
  <div class="arq__hero">
    <div class="wrap arq__copy">
      <p class="arq__lock">
        <Isologo part="arq" class="arq__lock-mark" />
        <span>Integhra <b>ARQ</b></span>
      </p>
      <Heading id="arq-title" class="arq__title">El ecosistema digital de la construcción y el diseño.</Heading>
      <p class="arq__body">En desarrollo. <a href="#waitlist">Sumate a la lista de espera</a>.</p>
    </div>

    <div class="arq__stage" aria-hidden="true">
      <Planta hero class="arq__plan" />
    </div>
  </div>

  <div class="wrap arq__actors">
    <h3>Conecta a</h3>
    <ul>{actores.map((a) => <li>{a}</li>)}</ul>
  </div>

  <Proceso />

  <WaitlistArq client:visible />
</section>

<style>
  .arq {
    --b: #1a6fc2;
    --v: #a33ab5;
    --line: #d5dbe3;
    --mut: #5d6676;
    background: #f3f5f8;
    color: #14171d;
    font-family: var(--font);
  }
  .arq ::selection {
    background: var(--b);
    color: #ffffff;
  }
  .arq :focus-visible {
    outline-color: #14171d;
  }

  /* ---------- Hero: product-page composition ---------- */
  .arq__hero {
    position: relative;
    /* a fixed height: the sheet is cut by the bottom edge instead of stretching the hero */
    height: max(640px, calc(100dvh - 72px));
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    overflow: hidden;
    background: #f3f5f8;
    text-align: center;
  }
  .arq__copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    padding-top: clamp(3rem, 9vh, 6rem);
  }
  .arq__lock {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .arq__lock :global(.arq__lock-mark) {
    width: auto;
    height: 30px;
  }
  .arq__lock b {
    font-weight: 400;
    color: #14171d;
  }
  .arq__title {
    font-size: clamp(2.6rem, 5.6vw, 5.5rem);
    font-weight: 800;
    font-variation-settings: 'wdth' 118;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
    max-width: 17ch;
  }
  .arq__body {
    margin-top: 0.4rem;
    color: #3a4250;
    font-size: 1.125rem;
    text-wrap: balance;
  }
  .arq__body a {
    color: var(--b);
    text-decoration: none;
  }
  .arq__body a:hover {
    text-decoration: underline;
  }

  /* The object: the plan lying on the table, seen in perspective, cut by the bottom edge */
  .arq__stage {
    position: relative;
    z-index: 1;
    perspective: 1500px;
    perspective-origin: 50% 0%;
    margin-top: clamp(2.25rem, 7vh, 4rem);
  }
  .arq__stage::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 55%;
    width: min(1100px, 90vw);
    height: 60%;
    translate: -50% -50%;
    background: radial-gradient(closest-side, rgb(26 111 194 / 0.12), transparent);
    pointer-events: none;
  }
  .arq__hero :global(.arq__plan) {
    width: min(860px, 70vw);
    margin: 0 auto;
    transform-origin: 50% 0%;
    transform: rotateX(52deg) rotateZ(-24deg);
    padding: 3%;
    /* a blueprint: deep blue paper with a faint grid, the drawing in light lines */
    background:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px) 0 0 / 28px 28px,
      #1b4e8c;
    box-shadow: 0 50px 80px -40px rgb(20 40 80 / 0.45);
  }
  .arq__hero :global(.arq__plan .pl-walls rect) {
    fill: #eaf2fb;
  }
  .arq__hero :global(.arq__plan .pl-win path) {
    stroke: #eaf2fb;
  }
  .arq__hero :global(.arq__plan .pl-door path) {
    stroke: rgb(234 242 251 / 0.75);
  }
  .arq__hero :global(.arq__plan .pl-furn :is(rect, path, ellipse)) {
    stroke: rgb(234 242 251 / 0.45);
  }
  .arq__hero :global(.arq__plan .pl-rooms),
  .arq__hero :global(.arq__plan .pl-north),
  .arq__hero :global(.arq__plan .pl-dims),
  .arq__hero :global(.arq__plan .pl-dimtxt) {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .arq__copy > * {
      animation: arq-rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .arq__copy > :nth-child(1) { animation-delay: 0.1s; }
    .arq__copy > :nth-child(2) { animation-delay: 0.2s; }
    .arq__copy > :nth-child(3) { animation-delay: 0.35s; }
    /* the sheet settles onto the table as it arrives */
    .arq__stage {
      animation: arq-lay 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
    }
    /* and, scrolling on, it lifts toward you a little */
    @supports (animation-timeline: view()) {
      .arq__hero :global(.arq__plan) {
        animation: arq-lift linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 80%;
      }
    }
  }
  @keyframes arq-rise {
    from { opacity: 0; transform: translateY(18px); }
  }
  @keyframes arq-lay {
    from { opacity: 0; transform: translateY(80px); }
  }
  @keyframes arq-lift {
    to { transform: rotateX(30deg) rotateZ(-12deg); }
  }

  .arq__actors {
    margin-top: clamp(4rem, 9vh, 6rem);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 2rem;
  }
  .arq__actors h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--mut);
  }
  .arq__actors ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
  }
  .arq__actors li {
    font-size: clamp(1.25rem, 2.2vw, 2rem);
    font-weight: 700;
    font-variation-settings: 'wdth' 70;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .arq__actors li:nth-child(odd) {
    color: var(--b);
  }

  /* Phones: same order, the sheet bigger so it still reads as an object */
  @media (max-width: 760px) {
    .arq__lock {
      font-size: 1.125rem;
    }
    .arq__hero :global(.arq__plan) {
      width: 112vw;
      margin-left: -6vw;
    }
  }
</style>
