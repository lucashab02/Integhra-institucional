---
// Home: the mark opens into the two products, and the two products become their cards.
// One scroll sequence on desktop: the closed mark splits into the VET and ARQ pairs, the dark
// diagonal straightens into the ARQ card, the light side settles into the VET card and each pair
// lands at the foot of its card. One message, one set of actions, at the end.
//
// Layout modes:
// - Flow (default, phones, reduced motion, no JS): hero, then the cards as a normal section.
// - Fused (desktop with JS and motion): the cards sit inside the pinned stage, over the hero.
import Isologo from '../marca/Isologo.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const arrow = '<path d="M5 12h14M13 6l6 6-6 6" />';
---

<section class="ph" aria-labelledby="ph-title">
  <div class="ph__stage">
    <div class="ph__hero">
      <div class="ph__copy wrap">
        <h1 id="ph-title" class="display ph__title">Conectamos<br />cada industria</h1>
        <p class="lede ph__lede">
          Integhra digitaliza y conecta proveedores, profesionales y consumidores. Una plataforma por industria, sin intermediarios.
        </p>
      </div>

      <div class="ph__split">
        <!-- ARQ's ground: the diagonal seam that opens with the mark and becomes the ARQ card -->
        <div class="ph__night" aria-hidden="true"></div>

        <div class="ph__mark" aria-hidden="true">
          <Isologo part="vet" fullFrame class="ph__half ph__half--vet" />
          <Isologo part="arq" fullFrame class="ph__half ph__half--arq" />
        </div>
      </div>
    </div>

    <div id="productos" class="ph__end" aria-labelledby="prod-title">
      <header class="prod__head">
        <h2 id="prod-title" class="prod__title">Una plataforma por industria</h2>
        <p class="prod__lede">Cada producto está diseñado para la cadena de valor completa de su sector.</p>
      </header>

      <div class="prod__grid">
        <article class="tile tile--vet" aria-labelledby="tile-vet">
          <div class="tile__copy">
            <p class="tile__state">En servicio desde 2024</p>
            <h3 id="tile-vet" class="tile__name">Integhra <b>VET</b></h3>
            <p class="tile__line">El ecosistema digital de la industria veterinaria.</p>
            <div class="tile__acts">
              <a class="tile__btn tile__btn--main" href={`${BASE}vet`}>
                Conocer más
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
              </a>
              <a class="tile__btn" href="#" data-contact="demo">Solicitar demo</a>
            </div>
          </div>
          <Isologo part="vet" class="tile__mark" />
        </article>

        <article class="tile tile--arq" aria-labelledby="tile-arq">
          <div class="tile__copy">
            <p class="tile__state">En desarrollo</p>
            <h3 id="tile-arq" class="tile__name">Integhra <b>ARQ</b></h3>
            <p class="tile__line">El ecosistema digital de la construcción y el diseño.</p>
            <div class="tile__acts">
              <a class="tile__btn tile__btn--main" href={`${BASE}arq`}>
                Conocer más
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
              </a>
              <a class="tile__btn" href={`${BASE}arq#waitlist`}>Anotarme</a>
            </div>
          </div>
          <Isologo part="arq" class="tile__mark" />
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Flow layout (default) ---------- */
  .ph {
    --S: min(58vh, 38vw);
    position: relative;
    background: var(--paper);
  }
  .ph__hero {
    position: relative;
    height: calc(100dvh - 72px);
    min-height: 620px;
    overflow: hidden;
    border-bottom: 2px solid var(--ink);
  }
  .ph__copy {
    position: relative;
    z-index: 4;
    padding-top: clamp(2.5rem, 7vh, 5rem);
    pointer-events: none;
  }
  .ph__title {
    font-size: clamp(2.8rem, 5.2vw, 5.25rem);
    max-width: 11ch;
  }
  .ph__lede {
    margin-top: 1.4rem;
    max-width: 36ch;
  }

  .ph__split {
    position: absolute;
    inset: 0;
  }
  .ph__night {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #121419;
    clip-path: polygon(52% 0, 100% 0, 100% 100%, 74% 100%);
  }

  .ph__mark {
    position: absolute;
    z-index: 3;
    left: 70%;
    top: 52%;
    width: var(--S);
    aspect-ratio: 860 / 872;
    translate: -50% -50%;
    pointer-events: none;
  }
  .ph__mark :global(.ph__half) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    will-change: transform;
  }
  /* Opened positions, in viewport terms so the halves land in their own worlds.
     The script reads these same numbers to plan the landing in the cards. */
  .ph__mark :global(.ph__half--vet) {
    transform: translate(-30vw, 19vh) scale(0.66) rotate(-6deg);
  }
  .ph__mark :global(.ph__half--arq) {
    transform: translate(7vw, -15vh) scale(0.66) rotate(6deg);
  }

  /* The products, as a section after the hero */
  .ph__end {
    position: relative;
    z-index: 2;
    padding: clamp(5rem, 12vh, 8rem) var(--wrap-x);
  }
  .prod__head {
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
  .prod__title {
    font-size: clamp(2.4rem, 4.6vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    text-wrap: balance;
  }
  .prod__lede {
    font-size: 1.1875rem;
    color: var(--ink-2);
    max-width: 44ch;
    text-wrap: balance;
  }
  .prod__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  /* A card: copy centered on top, the product's pair rising from the bottom edge */
  .tile {
    position: relative;
    overflow: hidden;
    min-height: clamp(560px, 70vh, 680px);
    padding: clamp(2.25rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem) 0;
    display: grid;
    grid-template-rows: auto 1fr;
    justify-items: center;
    text-align: center;
  }
  .tile__copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.75rem;
    justify-items: center;
  }
  .tile__state {
    font-size: 0.9375rem;
    font-weight: 650;
  }
  .tile__name {
    font-size: clamp(2.4rem, 4vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .tile__line {
    font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
    max-width: 26ch;
    text-wrap: balance;
  }
  .tile__acts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }
  .tile__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0 1.3rem;
    font-weight: 750;
    text-decoration: none;
    border: 2px solid currentColor;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s var(--ease-out);
  }
  .tile__btn svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s var(--ease-out);
  }
  .tile__btn:hover svg {
    transform: translateX(4px);
  }
  .tile__btn:active {
    transform: scale(0.98);
  }
  .tile :global(.tile__mark) {
    align-self: end;
    width: auto;
    height: clamp(220px, 32vh, 320px);
    margin-bottom: -12%;
  }

  /* VET: warm, round */
  .tile--vet {
    border-radius: 32px;
    background: #fff3ec;
    color: var(--ink);
  }
  .tile--vet .tile__state {
    color: #0b6e77;
  }
  .tile--vet .tile__name b {
    color: #ff4a1c;
  }
  .tile--vet .tile__line {
    color: #3d3a38;
  }
  .tile--vet .tile__btn {
    border-radius: 999px;
  }
  .tile--vet .tile__btn--main {
    background: #ff4a1c;
    border-color: #ff4a1c;
  }
  .tile--vet .tile__btn--main:hover {
    background: #ff6a43;
  }
  .tile--vet .tile__btn:not(.tile__btn--main):hover {
    background: #fff;
  }

  /* ARQ: graphite, square (its card is the diagonal of the hero, straightened) */
  .tile--arq {
    background: #121419;
    color: #eef1f6;
  }
  .tile--arq .tile__state {
    color: #8fc8f8;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.8125rem;
  }
  .tile--arq .tile__name {
    font-variation-settings: 'wdth' 120;
  }
  .tile--arq .tile__name b {
    color: #c04fd3;
  }
  .tile--arq .tile__line {
    color: #c3c9d4;
  }
  .tile--arq .tile__btn {
    border-radius: 0;
  }
  .tile--arq .tile__btn--main {
    background: #eef1f6;
    border-color: #eef1f6;
    color: #121419;
  }
  .tile--arq .tile__btn--main:hover {
    background: #fff;
  }
  .tile--arq .tile__btn:not(.tile__btn--main):hover {
    background: #eef1f6;
    color: #121419;
  }
  .tile--arq :focus-visible {
    outline-color: #eef1f6;
  }

  /* ---------- Fused layout: desktop with JS and motion ---------- */
  @media (min-width: 761px) and (prefers-reduced-motion: no-preference) {
    :global(.js) .ph {
      height: 365vh;
    }
    :global(.js) .ph__stage {
      position: sticky;
      top: 72px;
      height: calc(100dvh - 72px);
      min-height: 520px;
      overflow: hidden;
      border-bottom: 2px solid var(--ink);
    }
    :global(.js) .ph__hero {
      position: absolute;
      inset: 0;
      height: auto;
      min-height: 0;
      border-bottom: 0;
    }
    :global(.js) .ph__end {
      position: absolute;
      inset: 0;
      padding: clamp(1.25rem, 3.5vh, 2.25rem) var(--wrap-x);
      display: grid;
      grid-template-rows: auto minmax(0, 1fr);
    }
    :global(.js) .prod__head {
      gap: 0.5rem;
      margin-bottom: clamp(1rem, 3vh, 1.75rem);
    }
    :global(.js) .prod__title {
      font-size: clamp(2rem, 3.4vw, 3.25rem);
    }
    :global(.js) .prod__lede {
      font-size: 1.0625rem;
    }
    :global(.js) .prod__grid {
      min-height: 0;
    }
    :global(.js) .tile {
      min-height: 0;
      padding-top: clamp(1.5rem, 4vh, 2.75rem);
    }
    :global(.js) .tile__copy {
      gap: 0.5rem;
    }
    :global(.js) .tile__name {
      font-size: clamp(2rem, 3.2vw, 3rem);
    }
    :global(.js) .tile :global(.tile__mark) {
      height: clamp(130px, 26vh, 300px);
      margin-bottom: -10%;
    }
    /* The cards' grounds arrive from the hero: VET's fades in, ARQ's is the night itself */
    :global(.js) .tile--vet,
    :global(.js) .tile--arq {
      background: transparent;
    }
    /* Everything of the end state waits for the scroll; the script reveals it */
    :global(.js) .prod__head,
    :global(.js) .tile__copy,
    :global(.js) .tile :global(.tile__mark) {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* ---------- Phones: copy, a square stage where the mark opens, then the cards ---------- */
  @media (max-width: 760px) {
    .ph {
      --S: min(70vw, 300px);
    }
    .ph__hero {
      height: auto;
      min-height: 0;
      overflow: visible;
    }
    .ph__copy {
      padding-bottom: 1.5rem;
    }
    .ph__split {
      position: relative;
      inset: auto;
      height: 110vw;
      max-height: 560px;
      overflow: hidden;
    }
    .ph__night {
      clip-path: polygon(0 0, 100% 0, 100% 38%, 0 62%);
    }
    .ph__mark {
      left: 50%;
      top: 50%;
    }
    .ph__mark :global(.ph__half--vet) {
      transform: translate(-16vw, 16vw) scale(0.62) rotate(-6deg);
    }
    .ph__mark :global(.ph__half--arq) {
      transform: translate(16vw, -20vw) scale(0.62) rotate(6deg);
    }
    .ph__end {
      padding-block: clamp(3.5rem, 10vh, 5rem);
    }
    .prod__grid {
      grid-template-columns: 1fr;
    }
    .tile {
      min-height: 0;
      gap: 2rem;
    }
    .tile :global(.tile__mark) {
      height: 200px;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>('.ph');
  if (root) {
    const mm = gsap.matchMedia();
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const parts = {
      stage: q('.ph__stage'),
      hero: q('.ph__hero'),
      copy: q('.ph__copy'),
      night: q('.ph__night'),
      vet: q('.ph__half--vet'),
      arq: q('.ph__half--arq'),
      head: q('.prod__head'),
      tileVet: q('.tile--vet'),
      tileArq: q('.tile--arq'),
      tileCopies: root.querySelectorAll('.tile__copy'),
      tileMarks: root.querySelectorAll('.tile__mark'),
    };

    const closed = { x: 0, y: 0, xPercent: 0, yPercent: 0, scale: 1, rotate: 0 };
    const petal = (name: string) => root.querySelector('.iso__p--' + name);
    const petalsOf = (pair: 'vet' | 'arq') =>
      pair === 'vet' ? [petal('naranja'), petal('turquesa')] : [petal('azul'), petal('violeta')];

    // Each pair opens the same way: its two petals pull apart and grow a little as they leave
    // the shared mark. The cold pair mirrors the warm one (small petal out and away, big
    // petal the other way). Uses percent offsets so x and y stay free for the pointer.
    const shape = (tl: gsap.core.Timeline, at: number) =>
      tl
        .to(petal('naranja'), { rotate: -9, xPercent: -8, yPercent: -6, scale: 1.06, duration: 1 }, at)
        .to(petal('turquesa'), { rotate: 12, xPercent: 22, yPercent: 14, scale: 1.02, duration: 1 }, at)
        .to(petal('azul'), { rotate: 16, xPercent: -62, yPercent: -14, scale: 1.1, duration: 1 }, at)
        .to(petal('violeta'), { rotate: -8, xPercent: 10, yPercent: 0, scale: 1.06, duration: 1 }, at);

    // Desktop: one pinned sequence. The mark opens, then the hero becomes the two cards.
    mm.add('(min-width: 761px) and (prefers-reduced-motion: no-preference)', () => {
      // Geometry, in stage pixels. Read on every refresh so resizes keep the landing exact.
      const box = (el: Element) => {
        const s = parts.hero.getBoundingClientRect();
        const r = el.getBoundingClientRect();
        return { l: r.left - s.left, t: r.top - s.top, r: r.right - s.left, b: r.bottom - s.top, w: r.width, h: r.height };
      };
      const poly = (pts: number[][]) => 'polygon(' + pts.map(([x, y]) => x + 'px ' + y + 'px').join(', ') + ')';
      const W = () => parts.hero.clientWidth;
      const H = () => parts.hero.clientHeight;
      const shut = () => poly([[W(), 0], [W(), 0], [W(), H()], [W(), H()]]);
      const diagonal = () => poly([[W() * 0.52, 0], [W(), 0], [W(), H()], [W() * 0.74, H()]]);
      const arqCard = () => {
        const b = box(parts.tileArq);
        return poly([[b.l, b.t], [b.r, b.t], [b.r, b.b], [b.l, b.b]]);
      };

      // Where a pair has to go to sit on its card's mark. The half is the whole mark's frame
      // (860 x 872) with only its pair drawn; the pair's own box inside it comes from the logo.
      const pairBox = { vet: [0, 0, 600, 872], arq: [500, 40, 360, 750] };
      const land = (pair: 'vet' | 'arq', i: number) => {
        const S = Math.min(innerHeight * 0.58, innerWidth * 0.38);
        const fw = S;
        const fh = (S * 872) / 860;
        const [bx, by, bw, bh] = pairBox[pair];
        const dx = ((bx + bw / 2) / 860 - 0.5) * fw;
        const dy = ((by + bh / 2) / 872 - 0.5) * fh;
        const mark = parts.tileMarks[i];
        const m = box(mark);
        const markY = Number(gsap.getProperty(mark, 'y')) || 0;
        const scale = m.h / ((bh / 872) * fh);
        const cx = W() * 0.7;
        const cy = H() * 0.52;
        return {
          x: m.l + m.w / 2 - cx - scale * dx,
          y: m.t - markY + m.h / 2 - cy - scale * dy,
          scale,
        };
      };

      const tl = gsap.timeline({
        defaults: { ease: 'power2.inOut' },
        scrollTrigger: { trigger: root, start: 'top 72px', end: 'bottom bottom', scrub: 0.6, invalidateOnRefresh: true },
      });

      // 1. The mark opens into the two pairs, the night comes in on the diagonal
      tl.from([parts.vet, parts.arq], { ...closed, duration: 1 }, 0.1)
        .fromTo(parts.night, { clipPath: shut }, { clipPath: diagonal, duration: 1 }, 0.1);
      shape(tl, 0.1);

      // 2. The hero becomes the cards
      const at = 1.35;
      const T = 1.35; // the handover to the cards runs slower than the opening, so it can be watched
      const t = (n: number) => at + n * T;
      tl.to(parts.copy, { autoAlpha: 0, y: -48, duration: 0.45 * T, ease: 'power2.in' }, at)
        .to(parts.night, { clipPath: arqCard, duration: T }, at)
        .fromTo(parts.tileVet, { backgroundColor: 'rgba(255, 243, 236, 0)' }, { backgroundColor: 'rgba(255, 243, 236, 1)', duration: 0.7 * T }, t(0.35))
        .to(parts.vet, { x: () => land('vet', 0).x, y: () => land('vet', 0).y, scale: () => land('vet', 0).scale, rotate: 0, duration: T }, at)
        .to(parts.arq, { x: () => land('arq', 1).x, y: () => land('arq', 1).y, scale: () => land('arq', 1).scale, rotate: 0, duration: T }, at)
        .to([...petalsOf('vet'), ...petalsOf('arq')], { rotate: 0, xPercent: 0, yPercent: 0, scale: 1, duration: T }, at)
        .fromTo(parts.head, { autoAlpha: 0, y: 36 }, { autoAlpha: 1, y: 0, duration: 0.5 * T, ease: 'power2.out' }, t(0.4))
        .fromTo(parts.tileCopies, { autoAlpha: 0, y: 28 }, { autoAlpha: 1, y: 0, stagger: 0.12, duration: 0.5 * T, ease: 'power2.out' }, t(0.6))
        // the pairs hand over to the cards' own marks, which sit exactly where they landed
        .fromTo(parts.tileMarks, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.2 * T, ease: 'none' }, t(0.95))
        .to([parts.vet, parts.arq], { autoAlpha: 0, duration: 0.2 * T, ease: 'none' }, t(1.1))
        // a short hold on the finished cards before the page moves on
        .to({}, { duration: 0.35 });
    });

    // Fine pointers: the petals drift toward the cursor, each at its own depth
    mm.add('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)', () => {
      const depth: [string, number][] = [['naranja', 16], ['turquesa', -11], ['azul', 22], ['violeta', -14]];
      const movers = depth.map(([n, d]) => {
        const el = petal(n);
        return { d, x: gsap.quickTo(el, 'x', { duration: 0.9, ease: 'power3.out' }), y: gsap.quickTo(el, 'y', { duration: 0.9, ease: 'power3.out' }) };
      });
      const onMove = (e: PointerEvent) => {
        const r = parts.hero.getBoundingClientRect();
        const nx = (e.clientX - r.left) / r.width - 0.5;
        const ny = (e.clientY - Math.max(r.top, 0)) / window.innerHeight - 0.5;
        movers.forEach((m) => { m.x(nx * m.d); m.y(ny * m.d); });
      };
      const onLeave = () => movers.forEach((m) => { m.x(0); m.y(0); });
      parts.hero.addEventListener('pointermove', onMove);
      parts.hero.addEventListener('pointerleave', onLeave);
      return () => {
        parts.hero.removeEventListener('pointermove', onMove);
        parts.hero.removeEventListener('pointerleave', onLeave);
      };
    });

    // Phones: no pin, the mark opens while its square passes through the viewport
    mm.add('(max-width: 760px) and (prefers-reduced-motion: no-preference)', () => {
      const tl = gsap.timeline({
        defaults: { ease: 'power2.inOut' },
        scrollTrigger: { trigger: root.querySelector('.ph__split'), start: 'top 85%', end: 'center 45%', scrub: 0.5 },
      });
      tl.from([parts.vet, parts.arq], { ...closed, duration: 1 }, 0)
        .from(parts.night, { clipPath: 'polygon(0 0, 100% 0, 100% 0, 0 0)', duration: 1 }, 0);
      shape(tl, 0);
    });
  }
</script>
