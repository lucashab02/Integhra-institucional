---
// Floor plan for the ARQ section: a 2-bedroom apartment drawn to scale, presented as an
// editorial drawing rather than a working document. The geometry is real (units are cm:
// 9.60 x 7.00 m footprint, 30 cm exterior and 15 cm interior walls, doors and furniture at
// true size), so it holds up to an architect's eye; the annotation is kept to the minimum.

import { walls, windows, doors } from './planta-geo';

// Room names only: the drawing explains itself
const rooms = [
  { name: 'Living', x: 240, y: 214 },
  { name: 'Cocina', x: 225, y: 530 },
  { name: 'Baño', x: 470, y: 560 },
  { name: 'Dormitorio', x: 660, y: 168 },
  { name: 'Dormitorio', x: 660, y: 576 },
];
const sup = ((960 * 700) / 10000).toFixed(2).replace('.', ',');

interface Props {
  /** Drawn as the ground of the ARQ hero: no frame, no caption, it draws itself on load */
  hero?: boolean;
  class?: string;
}
const { hero = false, class: cls } = Astro.props;
---

<figure class:list={['pl', { 'pl--hero': hero }, cls]} aria-labelledby={hero ? undefined : 'pl-cap'}>
  <svg viewBox="-60 -70 1130 900" role="img" aria-labelledby="pl-title pl-desc">
    <title id="pl-title">Planta tipo</title>
    <desc id="pl-desc">
      Departamento de dos dormitorios de 9,60 por 7,00 metros: living-comedor, cocina, baño y dos dormitorios. Plano ilustrativo.
    </desc>

    <!-- Furniture: only what tells the room what it is, in a fine line -->
    <g class="pl-furn pl-l3">
      <!-- living: sofa and dining table with four chairs -->
      <rect pathLength="1" x="70" y="58" width="200" height="80" rx="10" />
      <path pathLength="1" d="M70 80 H270" />
      <rect pathLength="1" x="170" y="280" width="140" height="80" rx="4" />
      <rect pathLength="1" x="196" y="246" width="34" height="26" rx="6" />
      <rect pathLength="1" x="250" y="246" width="34" height="26" rx="6" />
      <rect pathLength="1" x="196" y="368" width="34" height="26" rx="6" />
      <rect pathLength="1" x="250" y="368" width="34" height="26" rx="6" />
      <!-- kitchen: L counter with sink and cooktop -->
      <path pathLength="1" d="M30 470 H90 V610 H300 V670" />
      <rect pathLength="1" x="44" y="502" width="32" height="64" rx="6" />
      <rect pathLength="1" x="158" y="620" width="76" height="40" rx="4" />
      <!-- bath: shower, basin, toilet -->
      <rect pathLength="1" x="375" y="580" width="90" height="90" />
      <path pathLength="1" d="M375 670 L465 580" />
      <ellipse pathLength="1" cx="399" cy="476" rx="14" ry="22" />
      <rect pathLength="1" x="555" y="590" width="20" height="46" rx="3" />
      <ellipse pathLength="1" cx="535" cy="613" rx="20" ry="15" />
      <!-- bedrooms: a double bed, two singles -->
      <rect pathLength="1" x="740" y="100" width="190" height="140" rx="4" />
      <path pathLength="1" d="M900 108 V232 M900 170 H930" />
      <rect pathLength="1" x="740" y="440" width="190" height="90" rx="4" />
      <rect pathLength="1" x="740" y="566" width="190" height="90" rx="4" />
      <path pathLength="1" d="M900 448 V522 M900 574 V648" />
    </g>

    <!-- Walls: solid section fill -->
    <g class="pl-walls pl-l1">
      {walls.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} />)}
    </g>

    <!-- Windows: a single glazing line in the middle of the wall -->
    <g class="pl-win pl-l2">
      {windows.map(([x, y, w, h]) => (
        <path pathLength="1" d={w > h ? `M${x} ${y + h / 2} H${x + w}` : `M${x + w / 2} ${y} V${y + h}`} />
      ))}
    </g>

    <!-- Doors: leaf and swing -->
    <g class="pl-door pl-l2">
      {doors.map((d) => (
        <g>
          <path pathLength="1" class="pl-leaf" d={`M${d.leaf[0]} ${d.leaf[1]} L${d.leaf[2]} ${d.leaf[3]}`} />
          <path pathLength="1" class="pl-swing" d={d.arc} />
        </g>
      ))}
    </g>

    <!-- Room names -->
    <g class="pl-rooms pl-l5">
      {rooms.map((r) => <text x={r.x} y={r.y} text-anchor="middle">{r.name}</text>)}
    </g>

    <!-- Overall dimensions only -->
    <g class="pl-dims pl-l4">
      <path pathLength="1" d="M0 742 H960 M1002 0 V700" />
      <path pathLength="1" class="pl-tick" d="M-7 749 L7 735 M953 749 L967 735 M995 7 L1009 -7 M995 707 L1009 693" />
    </g>
    <g class="pl-dimtxt pl-l5">
      <text x="480" y="776" text-anchor="middle">9,60</text>
      <text x="1036" y="350" text-anchor="middle" transform="rotate(-90 1036 350)">7,00</text>
    </g>

    <!-- North -->
    <g class="pl-north pl-l5" transform="translate(-24 -36)">
      <path d="M0 -18 L7 10 L0 5 L-7 10 Z" />
      <text y="-26" text-anchor="middle">N</text>
    </g>
  </svg>
  {!hero && (
    <figcaption id="pl-cap" class="pl-block">
      <span>Planta tipo · Esc. 1:50</span>
      <span>{sup} m²</span>
    </figcaption>
  )}
</figure>

<style>
  .pl {
    margin: 0;
    padding: clamp(1.25rem, 2.6vw, 2.25rem);
    border: 1px solid var(--line, #2a303b);
    background: #14171d;
    font-variant-numeric: tabular-nums;
  }
  .pl svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* One light ink, one accent (the dimensions), weights by role */
  .pl-walls rect {
    fill: #d9dee6;
  }
  .pl-win path {
    fill: none;
    stroke: #d9dee6;
    stroke-width: 2;
  }
  .pl-door path {
    fill: none;
    stroke: #8a94a4;
  }
  .pl-door .pl-leaf {
    stroke-width: 2.5;
  }
  .pl-door .pl-swing {
    stroke-width: 1;
    stroke-dasharray: none;
    opacity: 0.8;
  }
  .pl-furn :is(rect, path, ellipse) {
    fill: none;
    stroke: #5d6676;
    stroke-width: 1.3;
  }
  .pl-dims path {
    fill: none;
    stroke: var(--b, #3aa3f5);
    stroke-width: 1;
    opacity: 0.85;
  }
  .pl-dims .pl-tick {
    stroke-width: 2;
    opacity: 1;
  }
  .pl svg text {
    font-family: var(--font);
  }
  .pl-rooms text {
    fill: #a9b1be;
    font-size: 24px;
    letter-spacing: 0.02em;
  }
  .pl-dimtxt text {
    fill: var(--b, #3aa3f5);
    font-size: 23px;
  }
  .pl-north path {
    fill: #a9b1be;
  }
  .pl-north text {
    fill: #a9b1be;
    font-size: 18px;
  }

  /* Caption: two facts, quietly */
  .pl-block {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line, #2a303b);
    font-size: 0.8125rem;
    color: #a9b1be;
  }

  /* The drawing builds as it crosses the viewport: walls, openings, furniture, then words */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pl:not(.pl--hero) .pl-l1 {
        animation: pl-fade linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }
      .pl:not(.pl--hero) :is(.pl-l2, .pl-l3, .pl-l4) [pathLength] {
        stroke-dasharray: 1;
        animation: pl-draw linear both;
        animation-timeline: view();
      }
      .pl:not(.pl--hero) .pl-l2 [pathLength] { animation-range: cover 15% cover 38%; }
      .pl:not(.pl--hero) .pl-l3 [pathLength] { animation-range: cover 22% cover 45%; }
      .pl:not(.pl--hero) .pl-l4 [pathLength] { animation-range: cover 28% cover 50%; }
      .pl:not(.pl--hero) .pl-l5 {
        animation: pl-fade linear both;
        animation-timeline: view();
        animation-range: cover 35% cover 55%;
      }
    }
  }
  /* As the hero's ground: no frame, and it draws itself once, on arrival */
  .pl--hero {
    padding: 0;
    border: 0;
    background: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pl--hero .pl-l1 {
      animation: pl-fade 0.9s ease-out both;
    }
    .pl--hero :is(.pl-l2, .pl-l3, .pl-l4) [pathLength] {
      stroke-dasharray: 1;
      animation: pl-draw 1.4s cubic-bezier(0.65, 0, 0.35, 1) both;
    }
    .pl--hero .pl-l2 [pathLength] { animation-delay: 0.35s; }
    .pl--hero .pl-l3 [pathLength] { animation-delay: 0.7s; }
    .pl--hero .pl-l4 [pathLength] { animation-delay: 1s; }
    .pl--hero .pl-l5 {
      animation: pl-fade 0.8s ease-out 1.5s both;
    }
  }
  @keyframes pl-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes pl-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Phones: the drawing is a third of the size, so the words grow */
  @media (max-width: 600px) {
    .pl-rooms text,
    .pl-dimtxt text {
      font-size: 30px;
    }
    .pl-north text {
      font-size: 24px;
    }
  }
</style>
