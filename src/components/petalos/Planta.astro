---
// Floor plan for the ARQ section: a 2-bedroom apartment drawn to scale.
// Units are centimetres (1 SVG unit = 1 cm). Outer footprint 9.60 x 7.00 m,
// exterior walls 30 cm, interior walls 15 cm. Every area and dimension below is
// derived from these coordinates, so the numbers on the drawing add up.

type R = [number, number, number, number]; // x, y, w, h
type Span = [number, number];

// Split a wall into solid pieces, leaving the given openings (along its long axis)
const wall = (x0: number, y0: number, x1: number, y1: number, open: Span[] = []): R[] => {
  const horiz = x1 - x0 >= y1 - y0;
  const [a, b] = horiz ? [x0, x1] : [y0, y1];
  const cuts = [...open].sort((p, q) => p[0] - q[0]);
  const out: R[] = [];
  let s = a;
  for (const [o0, o1] of [...cuts, [b, b] as Span]) {
    if (o0 > s) out.push(horiz ? [s, y0, o0 - s, y1 - y0] : [x0, s, x1 - x0, o0 - s]);
    s = Math.max(s, o1);
  }
  return out;
};

// Openings in the exterior walls
const topOpen: Span[] = [[110, 350], [480, 570], [680, 860]]; // living window, entry door, dorm 1 window
const bottomOpen: Span[] = [[430, 520], [680, 860]]; // bath window, dorm 2 window
const leftOpen: Span[] = [[140, 300], [470, 610]]; // living window, kitchen window

const walls: R[] = [
  // exterior
  ...wall(0, 0, 960, 30, topOpen),
  ...wall(0, 670, 960, 700, bottomOpen),
  ...wall(0, 30, 30, 670, leftOpen),
  ...wall(930, 30, 960, 670),
  // interior
  ...wall(450, 30, 465, 400, [[150, 330]]), // living | hall (open passage)
  ...wall(575, 30, 590, 670, [[230, 310], [370, 450]]), // hall | bedrooms (two doors)
  ...wall(30, 400, 575, 415, [[90, 250], [480, 560]]), // living-hall | kitchen-bath
  ...wall(360, 415, 375, 670), // kitchen | bath
  ...wall(590, 340, 930, 355), // dorm 1 | dorm 2
];

// Windows: [x, y, w, h] of the opening in the wall
const windows: R[] = [
  [110, 0, 240, 30],
  [680, 0, 180, 30],
  [430, 670, 90, 30],
  [680, 670, 180, 30],
  [0, 140, 30, 160],
  [0, 470, 30, 140],
];

// Openings without a door (lintel shown dashed on both faces)
const vanos = [
  { x0: 450, x1: 465, y0: 150, y1: 330 },
  { x0: 90, x1: 250, y0: 400, y1: 415 },
];

// Doors: leaf from the hinge, and the swing arc
const doors = [
  { leaf: [570, 30, 570, 120], arc: 'M480 30 A90 90 0 0 0 570 120' }, // entry
  { leaf: [560, 415, 560, 495], arc: 'M480 415 A80 80 0 0 0 560 495' }, // bath
  { leaf: [590, 230, 670, 230], arc: 'M590 310 A80 80 0 0 0 670 230' }, // dorm 1
  { leaf: [590, 450, 670, 450], arc: 'M590 370 A80 80 0 0 1 670 450' }, // dorm 2
];

// Rooms: interior clear size and label position
const rooms = [
  { name: 'Living-comedor', w: 420, h: 370, x: 355, y: 168 },
  { name: 'Hall', w: 110, h: 370, x: 520, y: 312, small: true },
  { name: 'Cocina', w: 330, h: 255, x: 225, y: 520 },
  { name: 'Baño', w: 200, h: 255, x: 470, y: 548 },
  { name: 'Dorm. 1', w: 340, h: 310, x: 665, y: 150 },
  { name: 'Dorm. 2', w: 340, h: 315, x: 665, y: 560 },
];
const m2 = (w: number, h: number) => ((w * h) / 10000).toFixed(2).replace('.', ',') + ' m²';
const sup = ((960 * 700) / 10000).toFixed(2).replace('.', ',');

// Dimension chains (in cm along the axis), rendered in metres
const chainX = [0, 375, 590, 960];
const chainY = [0, 355, 700];
const metres = (cm: number) => (cm / 100).toFixed(2);
const tick = (x: number, y: number) => `M${x - 9} ${y + 9} L${x + 9} ${y - 9}`;
---

<figure class="pl" aria-labelledby="pl-cap">
  <svg viewBox="-110 -120 1230 1050" role="img" aria-labelledby="pl-title pl-desc">
    <title id="pl-title">Planta tipo, escala 1:50</title>
    <desc id="pl-desc">
      Departamento de dos dormitorios de 9,60 por 7,00 metros: living-comedor, hall de acceso, cocina, baño y dos dormitorios. Plano ilustrativo.
    </desc>

    <!-- Furniture and fixtures (under the walls) -->
    <g class="pl-furn pl-l3">
      <!-- living: sofa, coffee table, dining table with four chairs -->
      <rect pathLength="1" x="60" y="55" width="210" height="85" rx="6" />
      <path pathLength="1" d="M60 78 H270 M82 78 V140 M248 78 V140" />
      <rect pathLength="1" x="120" y="178" width="90" height="48" rx="4" />
      <rect pathLength="1" x="170" y="272" width="140" height="80" rx="4" />
      <rect pathLength="1" x="192" y="233" width="38" height="34" rx="5" />
      <rect pathLength="1" x="250" y="233" width="38" height="34" rx="5" />
      <rect pathLength="1" x="192" y="357" width="38" height="34" rx="5" />
      <rect pathLength="1" x="250" y="357" width="38" height="34" rx="5" />
      <!-- kitchen: L counter, sink, cooktop, fridge -->
      <path pathLength="1" d="M30 415 H90 V610 H300 V670" />
      <rect pathLength="1" x="40" y="497" width="40" height="78" rx="4" />
      <rect pathLength="1" x="47" y="505" width="26" height="62" rx="3" />
      <rect pathLength="1" x="150" y="617" width="85" height="46" rx="3" />
      <circle pathLength="1" cx="171" cy="630" r="8" />
      <circle pathLength="1" cx="214" cy="630" r="8" />
      <circle pathLength="1" cx="171" cy="650" r="8" />
      <circle pathLength="1" cx="214" cy="650" r="8" />
      <rect pathLength="1" x="302" y="606" width="56" height="62" />
      <path pathLength="1" d="M302 606 L358 668" />
      <!-- bath: shower, washbasin, toilet -->
      <rect pathLength="1" x="375" y="580" width="90" height="90" />
      <path pathLength="1" d="M375 580 L465 670 M465 580 L375 670" />
      <circle pathLength="1" cx="420" cy="625" r="6" />
      <rect pathLength="1" x="377" y="440" width="44" height="70" rx="4" />
      <ellipse pathLength="1" cx="399" cy="475" rx="13" ry="22" />
      <rect pathLength="1" x="553" y="586" width="22" height="52" rx="3" />
      <ellipse pathLength="1" cx="532" cy="612" rx="21" ry="16" />
      <!-- dorm 1: double bed, nightstands, wardrobe -->
      <rect pathLength="1" x="740" y="100" width="190" height="140" rx="4" />
      <rect pathLength="1" x="896" y="108" width="28" height="58" rx="5" />
      <rect pathLength="1" x="896" y="174" width="28" height="58" rx="5" />
      <path pathLength="1" d="M832 100 V240" />
      <rect pathLength="1" x="895" y="60" width="35" height="34" />
      <rect pathLength="1" x="895" y="246" width="35" height="32" />
      <rect pathLength="1" x="700" y="284" width="230" height="56" />
      <!-- dorm 2: two single beds, wardrobe -->
      <rect pathLength="1" x="740" y="440" width="190" height="90" rx="4" />
      <rect pathLength="1" x="898" y="448" width="26" height="74" rx="5" />
      <rect pathLength="1" x="740" y="566" width="190" height="90" rx="4" />
      <rect pathLength="1" x="898" y="574" width="26" height="74" rx="5" />
      <rect pathLength="1" x="895" y="535" width="35" height="27" />
      <rect pathLength="1" x="700" y="355" width="230" height="56" />
    </g>
    <!-- wardrobe sliding doors and kitchen upper cabinets: dashed by convention -->
    <g class="pl-dash pl-l3">
      <path d="M700 312 H930 M700 383 H930" />
    </g>

    <!-- Walls: solid section fill -->
    <g class="pl-walls pl-l1">
      {walls.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} />)}
    </g>

    <!-- Windows: frame and glazing line inside the wall opening -->
    <g class="pl-win pl-l2">
      {windows.map(([x, y, w, h]) => (
        <g>
          <rect pathLength="1" x={x} y={y} width={w} height={h} />
          {w > h ? (
            <path pathLength="1" d={`M${x} ${y + h / 2 - 3} H${x + w} M${x} ${y + h / 2 + 3} H${x + w}`} />
          ) : (
            <path pathLength="1" d={`M${x + w / 2 - 3} ${y} V${y + h} M${x + w / 2 + 3} ${y} V${y + h}`} />
          )}
        </g>
      ))}
    </g>

    <!-- Openings without doors: lintel dashed on both faces -->
    <g class="pl-dash pl-l2">
      {vanos.map((v) =>
        v.x1 - v.x0 > v.y1 - v.y0 ? (
          <path d={`M${v.x0} ${v.y0} H${v.x1} M${v.x0} ${v.y1} H${v.x1}`} />
        ) : (
          <path d={`M${v.x0} ${v.y0} V${v.y1} M${v.x1} ${v.y0} V${v.y1}`} />
        ),
      )}
    </g>

    <!-- Doors: leaf and swing -->
    <g class="pl-door pl-l2">
      {doors.map((d) => (
        <g>
          <path pathLength="1" class="pl-leaf" d={`M${d.leaf[0]} ${d.leaf[1]} L${d.leaf[2]} ${d.leaf[3]}`} />
          <path pathLength="1" class="pl-swing" d={d.arc} />
        </g>
      ))}
    </g>

    <!-- Entry marker -->
    <g class="pl-entry pl-l4">
      <text x="525" y="-62" text-anchor="middle">ACCESO</text>
      <path d="M525 -48 V-14 M513 -26 L525 -12 L537 -26" />
    </g>

    <!-- Room names and areas -->
    <g class="pl-rooms pl-l5">
      {rooms.map((r) => (
        <g>
          <text class:list={['pl-room', { 'pl-room--sm': r.small }]} x={r.x} y={r.y} text-anchor="middle">{r.name.toUpperCase()}</text>
          <text class="pl-area" x={r.x} y={r.y + (r.small ? 24 : 28)} text-anchor="middle">{m2(r.w, r.h)}</text>
        </g>
      ))}
    </g>

    <!-- Dimensions: partial chain and overall, bottom and right -->
    <g class="pl-dims pl-l4">
      <path pathLength="1" d={`M0 712 V800 M960 712 V800 ${chainX.slice(1, -1).map((x) => `M${x} 712 V758`).join(' ')}`} class="pl-ext" />
      <path pathLength="1" d="M0 745 H960 M0 790 H960" />
      <path pathLength="1" d={chainX.map((x) => tick(x, 745)).join(' ') + ' ' + tick(0, 790) + ' ' + tick(960, 790)} class="pl-tick" />
      <path pathLength="1" d={`M972 0 H1060 M972 700 H1060 ${chainY.slice(1, -1).map((y) => `M972 ${y} H1018`).join(' ')}`} class="pl-ext" />
      <path pathLength="1" d="M1005 0 V700 M1050 0 V700" />
      <path pathLength="1" d={chainY.map((y) => tick(1005, y)).join(' ') + ' ' + tick(1050, 0) + ' ' + tick(1050, 700)} class="pl-tick" />
    </g>
    <g class="pl-dimtxt pl-l5">
      {chainX.slice(0, -1).map((x, i) => (
        <text x={(x + chainX[i + 1]) / 2} y="735" text-anchor="middle">{metres(chainX[i + 1] - x)}</text>
      ))}
      <text x="480" y="780" text-anchor="middle">{metres(960)}</text>
      {chainY.slice(0, -1).map((y, i) => (
        <text x="995" y={(y + chainY[i + 1]) / 2} text-anchor="middle" transform={`rotate(-90 995 ${(y + chainY[i + 1]) / 2})`}>{metres(chainY[i + 1] - y)}</text>
      ))}
      <text x="1040" y="350" text-anchor="middle" transform="rotate(-90 1040 350)">{metres(700)}</text>
    </g>

    <!-- North arrow and graphic scale -->
    <g class="pl-north pl-l4" transform="translate(-58 -62)">
      <circle r="26" />
      <path d="M0 -20 L9 12 L0 5 L-9 12 Z" />
      <text y="-34" text-anchor="middle">N</text>
    </g>
    <g class="pl-scale pl-l4" transform="translate(0 850)">
      <rect x="0" y="0" width="100" height="12" class="pl-scale-fill" />
      <rect x="100" y="0" width="100" height="12" />
      <rect x="200" y="0" width="100" height="12" class="pl-scale-fill" />
      <text x="0" y="42" text-anchor="middle">0</text>
      <text x="100" y="42" text-anchor="middle">1</text>
      <text x="200" y="42" text-anchor="middle">2</text>
      <text x="300" y="42" text-anchor="middle">3 m</text>
    </g>
  </svg>
  <figcaption id="pl-cap" class="pl-block">
    <span>RES 001/25</span>
    <span>Planta tipo · Esc 1:50</span>
    <span>Sup. cubierta {sup} m²</span>
    <span>Integhra ARQ</span>
  </figcaption>
</figure>

<style>
  .pl {
    margin: 0;
    border: 1px solid var(--line, #2a303b);
    padding: clamp(1rem, 2vw, 1.75rem);
    background:
      linear-gradient(#1c2028 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, #1c2028 1px, transparent 1px) 0 0 / 32px 32px;
    background-color: #14171d;
    font-variant-numeric: tabular-nums;
  }
  .pl svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Line weights by role, as on a drawing sheet */
  .pl-walls rect {
    fill: #dfe4ec;
  }
  .pl-win rect {
    fill: #14171d;
    stroke: #8fc8f8;
    stroke-width: 2;
  }
  .pl-win path {
    fill: none;
    stroke: #8fc8f8;
    stroke-width: 1.5;
  }
  .pl-door path {
    fill: none;
    stroke: var(--v, #c04fd3);
  }
  .pl-door .pl-leaf {
    stroke-width: 4;
  }
  .pl-door .pl-swing {
    stroke-width: 1.5;
  }
  .pl-furn :is(rect, path, circle, ellipse) {
    fill: none;
    stroke: #6f7a8c;
    stroke-width: 1.6;
  }
  .pl-dash path {
    fill: none;
    stroke: #6f7a8c;
    stroke-width: 1.4;
    stroke-dasharray: 8 7;
  }
  .pl-dims path {
    fill: none;
    stroke: var(--b, #3aa3f5);
    stroke-width: 1.4;
  }
  .pl-dims .pl-ext {
    stroke-width: 1;
    opacity: 0.7;
  }
  .pl-dims .pl-tick {
    stroke-width: 2.4;
  }
  .pl svg text {
    font-family: var(--font);
  }
  .pl-dimtxt text {
    fill: var(--b, #3aa3f5);
    font-size: 21px;
  }
  .pl-room {
    fill: #eef1f6;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .pl-room--sm {
    font-size: 17px;
  }
  .pl-area {
    fill: #9aa4b4;
    font-size: 17px;
  }
  .pl-entry text,
  .pl-north text,
  .pl-scale text {
    fill: #c3c9d4;
    font-size: 18px;
    letter-spacing: 0.06em;
  }
  .pl-entry path {
    fill: none;
    stroke: #c3c9d4;
    stroke-width: 2;
  }
  .pl-north circle {
    fill: none;
    stroke: #6f7a8c;
    stroke-width: 1.5;
  }
  .pl-north path {
    fill: #eef1f6;
  }
  .pl-scale rect {
    fill: none;
    stroke: #c3c9d4;
    stroke-width: 1.5;
  }
  .pl-scale .pl-scale-fill {
    fill: #c3c9d4;
  }

  /* Title block */
  .pl-block {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin-top: 1rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #a9b1be;
  }
  .pl-block span {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line, #2a303b);
    margin-left: -1px;
    margin-top: -1px;
  }

  /* The drawing builds as it crosses the viewport: walls, openings, furniture, dimensions, text */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pl-l1 {
        animation: pl-fade linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }
      .pl-l2 [pathLength],
      .pl-l3 [pathLength],
      .pl-l4 [pathLength] {
        stroke-dasharray: 1;
        animation: pl-draw linear both;
        animation-timeline: view();
      }
      .pl-l2 [pathLength] { animation-range: cover 15% cover 38%; }
      .pl-l3 [pathLength] { animation-range: cover 22% cover 45%; }
      .pl-l4 [pathLength] { animation-range: cover 28% cover 50%; }
      .pl-l2 .pl-dash,
      .pl-dash,
      .pl-entry,
      .pl-north,
      .pl-scale,
      .pl-l5 {
        animation: pl-fade linear both;
        animation-timeline: view();
        animation-range: cover 35% cover 55%;
      }
    }
  }
  @keyframes pl-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes pl-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Phones: the drawing is a third of the size, so text grows and areas step aside */
  @media (max-width: 600px) {
    .pl-room {
      font-size: 29px;
    }
    .pl-room--sm,
    .pl-area,
    .pl-entry text {
      display: none;
    }
    .pl-dimtxt text {
      font-size: 32px;
    }
    .pl-scale text,
    .pl-north text {
      font-size: 28px;
    }
  }
</style>
