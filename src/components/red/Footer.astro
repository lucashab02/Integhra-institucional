---
import Isologo from '../marca/Isologo.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const legend = [
  { part: 'vet', name: 'Integhra VET', state: 'En servicio desde 2024', href: `${BASE}general` },
  { part: 'arq', name: 'Integhra ARQ', state: 'En desarrollo', href: `${BASE}#arq` },
] as const;
---

<footer class="ft">
  <div class="ft__grid wrap">
    <div class="ft__brand">
      <a href={BASE} class="ft__logo" aria-label="Integhra, inicio">
        <Isologo class="ft__mark" />
        <span>Integhra</span>
      </a>
      <p>Tecnología que conecta cada industria. Soluciones verticales para sectores completos.</p>
      <a class="ft__mail" href="mailto:integhra@gmail.com">integhra@gmail.com</a>
    </div>

    <nav class="ft__legend" aria-label="Plataformas">
      <h2 class="ft__h">Plataformas</h2>
      <ul>
        {legend.map((l) => (
          <li>
            <a href={l.href}>
              <Isologo part={l.part} class="ft__pair" />
              <span class="ft__name">{l.name}</span>
              <span class="ft__state">{l.state}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="ft__nav" aria-label="Páginas">
      <h2 class="ft__h">Páginas</h2>
      <ul>
        <li><a href={BASE}>Inicio</a></li>
        <li><a href={`${BASE}general`}>Institucional</a></li>
        <li><a href={`${BASE}sobre-nosotros`}>Sobre nosotros</a></li>
        <li><a href={`${BASE}#waitlist`}>Lista de espera</a></li>
        <li><a href="#" data-contact>Contacto</a></li>
      </ul>
    </nav>
  </div>

  <div class="ft__base wrap">
    <p>© 2026 Integhra. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .ft {
    border-top: 2px solid var(--ink);
    padding-top: clamp(3.5rem, 8vh, 5.5rem);
    background: var(--paper);
  }
  .ft__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr) minmax(0, 0.7fr);
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .ft__brand {
    display: grid;
    align-content: start;
    gap: 1.1rem;
  }
  .ft__brand p {
    color: var(--ink-2);
    max-width: 34ch;
  }
  .ft__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }
  .ft__logo :global(.ft__mark) {
    width: 44px;
    height: 44px;
  }
  .ft__logo span {
    font-weight: 800;
    font-size: 1.875rem;
    letter-spacing: -0.03em;
    font-variation-settings: 'wdth' 112;
  }
  .ft__mail {
    font-weight: 650;
    justify-self: start;
  }
  .ft__h {
    font-size: 0.9375rem;
    font-weight: 650;
    color: var(--ink-3);
    margin-bottom: 1rem;
  }
  ul {
    list-style: none;
  }
  .ft__legend ul {
    display: grid;
    gap: 0.25rem;
  }
  .ft__legend a {
    display: grid;
    grid-template-columns: 56px 1fr;
    grid-template-rows: auto auto;
    column-gap: 1rem;
    align-items: center;
    padding: 0.6rem 0;
    text-decoration: none;
  }
  .ft__legend :global(.ft__pair) {
    grid-row: span 2;
    height: 44px;
    width: auto;
    justify-self: center;
    transition: transform 0.45s var(--ease-out);
  }
  .ft__legend a:hover :global(.ft__pair) {
    transform: rotate(-12deg) scale(1.08);
  }
  .ft__name {
    font-weight: 700;
  }
  .ft__state {
    font-size: 0.9375rem;
    color: var(--ink-3);
  }
  .ft__nav ul {
    display: grid;
    gap: 0.6rem;
  }
  .ft__nav a {
    text-decoration: none;
    font-weight: 560;
  }
  .ft__nav a:hover,
  .ft__legend a:hover .ft__name {
    text-decoration: underline;
  }
  .ft__base {
    margin-top: clamp(3rem, 7vh, 4.5rem);
    padding-block: 1.5rem 5rem;
    border-top: 2px solid var(--ink);
    font-size: 0.9375rem;
    color: var(--ink-3);
  }
  @media (min-width: 1180px) {
    .ft__base { padding-bottom: 1.5rem; }
  }
  @media (max-width: 900px) {
    .ft__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
