---
import Base from '../layouts/Base.astro';
import PetalHero from '../components/petalos/PetalHero.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base
  title="Integhra | Conectamos cada industria"
  description="Integhra es la plataforma tecnológica que digitaliza y conecta cada industria. Integhra VET (en producción) e Integhra ARQ (próximamente)."
  ogDescription="Plataforma tecnológica que digitaliza y conecta proveedores, profesionales y consumidores en Argentina."
  line="vet"
  world="petalos"
  stations={[]}
>
  <PetalHero />
</Base>

<!-- VET and ARQ used to live on this page: old anchors go to their new pages -->
<script is:inline define:vars={{ BASE }}>
  var moved = { '#vet': 'vet', '#arq': 'arq', '#recorrido': 'arq#recorrido', '#waitlist': 'arq#waitlist' };
  if (moved[location.hash]) location.replace(BASE + moved[location.hash]);
</script>
